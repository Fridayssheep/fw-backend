# =========================
# 后端运行
# =========================

# FastAPI 对外访问地址
BACKEND_BASE_URL=http://0.0.0.0:8000
BACKEND_TIMEOUT_SECONDS=30


# =========================
# Database
# =========================

# 推荐优先使用完整 DATABASE_URL。
# 如果未提供，则后端和脚本会回退到下面的 DB_* 变量。
#DATABASE_URL=postgresql://admin:adminpassword@127.0.0.1:5432/building_energy

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=building_energy
DB_USER=admin
DB_PASSWORD=adminpassword


# =========================
# AI / LLM
# =========================

LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:latest
LLM_TIMEOUT_SECONDS=420
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9

AI_ENABLE_HISTORY=true
AI_ENABLE_KNOWLEDGE=true
# 对AI提供的mcp工具
AI_ALLOWED_ACTION_TARGETS=energy_trend,energy_compare,energy_weather_correlation,energy_anomaly_analysis,/ai/anomaly-feedback


# =========================
# RAGFlow
# =========================

RAGFLOW_API_URL=http://127.0.0.1:9380/api/v1
RAGFLOW_API_KEY=
RAGFLOW_TIMEOUT_SECONDS=60
RAGFLOW_CHAT_MODEL=ragflow-chat
RAGFLOW_DATASET_IDS=
RAGFLOW_DEFAULT_CHAT_ID=