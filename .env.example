# =========================
# 后端运行
# =========================

# FastAPI 对外访问地址
BACKEND_BASE_URL=http://127.0.0.1:8000
BACKEND_TIMEOUT_SECONDS=30


# =========================
# Database
# =========================

# 推荐优先使用完整 DATABASE_URL。
# 如果未提供，则后端和脚本会回退到下面的 DB_* 变量。
#DATABASE_URL=postgresql://admin:adminpassword@127.0.0.1:5432/building_energy

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=building_energy
DB_USER=admin
DB_PASSWORD=adminpassword


# =========================
# AI / LLM
# =========================

LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:latest
LLM_TIMEOUT_SECONDS=420
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9

AI_ENABLE_HISTORY=true
AI_ENABLE_KNOWLEDGE=true
# 对AI提供的mcp工具
AI_ALLOWED_ACTION_TARGETS=energy_trend,energy_compare,energy_weather_correlation,energy_anomaly_analysis,/ai/anomaly-feedback


# =========================
# RAGFlow
# =========================

RAGFLOW_API_URL=http://127.0.0.1:9380/api/v1
RAGFLOW_API_KEY=
RAGFLOW_TIMEOUT_SECONDS=60
RAGFLOW_CHAT_MODEL=ragflow-chat
RAGFLOW_DATASET_IDS=
RAGFLOW_DEFAULT_CHAT_ID=


# =========================
# MCP / Demo Defaults
# =========================

MCP_DEFAULT_TIME_START=2017-01-01T00:00:00+00:00
MCP_DEFAULT_TIME_END=2017-01-07T00:00:00+00:00


# =========================
# Data Processing Scripts
# =========================

# dataprocess/import_data.py 可用；不填则默认读仓库内 data 目录

# DATA_BASE_DIR=


# =========================
# 测试用环境变量，可不选
# =========================

# /ai/qa
AI_QA_TEST_QUESTION=
AI_QA_TEST_SESSION_ID=
AI_QA_DIRECT_RAGFLOW_CHECK=1

# /ai/report-summary
AI_REPORT_SUMMARY_TEST_BUILDING_ID=
AI_REPORT_SUMMARY_TEST_METER=electricity
AI_REPORT_SUMMARY_TEST_START=
AI_REPORT_SUMMARY_TEST_END=
AI_REPORT_SUMMARY_TEST_REPORT_TYPE=weekly_summary
AI_REPORT_SUMMARY_TEST_AUDIENCE=manager
AI_REPORT_SUMMARY_TEST_QUESTION=
AI_REPORT_SUMMARY_INCLUDE_ANOMALY_INSIGHT=1
AI_REPORT_SUMMARY_INCLUDE_ACTIONS=1

AI_REPORT_SUMMARY_TEST_SOURCE=report_center
AI_REPORT_SUMMARY_TEST_PAGE_TYPE=weekly_card
AI_REPORT_SUMMARY_TEST_CHART_RANGE=7d

AI_REPORT_SUMMARY_METRICS_TOTAL=
AI_REPORT_SUMMARY_METRICS_AVERAGE=
AI_REPORT_SUMMARY_METRICS_PEAK=
AI_REPORT_SUMMARY_METRICS_PEAK_TIME=
AI_REPORT_SUMMARY_METRICS_UNIT=kWh
AI_REPORT_SUMMARY_COMPARE_TOTAL=
AI_REPORT_SUMMARY_COMPARE_CHANGE_RATE=

AI_REPORT_SUMMARY_TREND_DIRECTION=
AI_REPORT_SUMMARY_TREND_CHANGE_RATE=
AI_REPORT_SUMMARY_PEAK_DAYS=
AI_REPORT_SUMMARY_LOW_DAYS=
AI_REPORT_SUMMARY_TREND_NOTES=

AI_REPORT_SUMMARY_ANOMALY_SUMMARY=
AI_REPORT_SUMMARY_ANALYSIS_MODE=offline_event_review
AI_REPORT_SUMMARY_EVENT_COUNT=0
